// Serie de Fibonacci con un ciclo mientras y con recursión.
const TERMINOS : int = 15;

funcion fib(n : int) : int {
    si n < 2 { retornar n; }
    retornar fib(n - 1) + fib(n - 2);
}

funcion principal() : int {
    var a : int = 0;
    var b : int = 1;
    var i : int = 0;
    mientras i < TERMINOS {
        mostrar(i, a, fib(i));
        var siguiente : int = a + b;
        a = b;
        b = siguiente;
        i = i + 1;
    }
    retornar 0;
}
